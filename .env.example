# Copy to .env.local (gitignored) and fill in real values for local dev.
# All keys here are validated by libs/config/config-module.config.ts —
# missing or invalid values fail fast at boot.

NODE_ENV=development

# API gateway HTTP server
API_GATEWAY_PORT=3000
API_GATEWAY_PREFIX=api
# API_GATEWAY_USE_API_REFERENCE=true   # defaults true outside production

# Pino log level (fatal | error | warn | info | debug | trace)
LOG_LEVEL=debug

# MySQL (TypeORM)
DATABASE_URL=mysql://retail:retailpass@localhost:3306/retail_db
DATABASE_LOGGING=true

# Isolated event-store schema (ADR-034) — a separate logical database on the same
# MySQL instance, owned by the event-store microservice. Required by the shared config
# for every service even though only the event store opens it.
EVENTSTORE_DATABASE_URL=mysql://retail:retailpass@localhost:3306/ris_eventstore

# ISO-4217 currency the catalog publish precondition resolves against — a product
# publishes only when every variant has an in-effect price in this currency.
DEFAULT_CURRENCY=USD

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Redis
REDIS_URL=redis://localhost:6379

# Cache TTLs (milliseconds)
CACHE_TTL_MS_DEFAULT=60000
CACHE_TTL_MS_PRODUCT_STOCK=60000

# Stock reservation hold lifetime (minutes). A Reserve sets/refreshes the hold's
# expiresAt to now + this many minutes (ADR-030).
RESERVATION_TTL_MINUTES=15

# Expired-reservation sweep bounds (ADR-038). The batch size caps how many stranded holds
# one sweep invocation scans and expires; the transaction size caps how many it expires per
# transaction, bounding how long it holds row locks against concurrent checkout writes.
RESERVATION_SWEEP_BATCH_SIZE=200
RESERVATION_SWEEP_TRANSACTION_SIZE=25

# Seconds between expired-reservation sweep invocations. This decides only how promptly an
# already-expired hold is reclaimed — RESERVATION_TTL_MINUTES is what bounds a hold's life —
# so keep it well inside the TTL.
RESERVATION_SWEEP_INTERVAL_SECONDS=60

# Return-eligibility window (days). A shipped order is returnable only within this
# many days of its ship date; a delivered order is always returnable (ADR-032).
RETURN_WINDOW_DAYS=30

# Idempotency-key retention (hours). A stored idempotency record is eligible for the
# purge sweep once created_at + this many hours has passed (ADR-036).
IDEMPOTENCY_KEY_TTL_HOURS=24

# Bounded retry budget for optimistic-concurrency (version-checked) writes. On a
# version mismatch the write re-reads under a fresh transaction and retries up to this
# many attempts before surfacing a 409 VERSION_MISMATCH / STOCK_WRITE_CONFLICT (ADR-036).
OCC_RETRY_ATTEMPTS=5

# Ops mailbox for system-only notifications with no customer recipient (e.g. the
# inventory low-stock alert).
OPS_NOTIFICATIONS_EMAIL=ops@example.com
# Max attempts before a notification delivery is abandoned and
# notifications.delivery.failed is emitted.
MAX_DELIVERY_ATTEMPTS=3
# Retention window (days) for delivery rows; the purge worker is a future capability.
RETENTION_DELIVERY_DAYS=90
# TTL (seconds) for a cached notification consent snapshot. The consent cache is kept
# fresh by the customer.consent.updated / customer.erased events, so this is only a
# staleness safety net if an event is missed.
NOTIFICATIONS_CONSENT_CACHE_TTL_SECONDS=300
# TEST-ONLY flag. When true, the notification microservice binds a deterministically-flaky
# NOTIFIER (fails a delivery whose rendered body carries the e2e marker once) so the retry
# path can be exercised. Leave unset/false everywhere except the retry e2e suite; production
# must never enable it.
# NOTIFIER_TEST_FLAKY=false

# JWT (gateway auth). Use a 32+ char value per environment; never check
# real secrets into git. The two secrets must differ.
JWT_ACCESS_SECRET=development-access-secret-do-not-use-in-prod-32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=development-refresh-secret-do-not-use-in-prod-32chars
JWT_REFRESH_EXPIRES_IN=7d

# argon2id password hash cost (OWASP 2024 defaults)
AUTH_ARGON2_MEMORY_COST=19456
AUTH_ARGON2_TIME_COST=2
AUTH_ARGON2_PARALLELISM=1

# OpenTelemetry (ADR-014). Per-service OTEL_SERVICE_NAME is set in
# docker-compose.yml; for local non-docker runs, override per shell.
OTEL_SERVICE_NAME=api-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_RESOURCE_ATTRIBUTES=team=platform
# OTEL_SDK_DISABLED=false
