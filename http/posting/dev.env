# Posting environment — dev (mirror of http/kulala/http-client.env.json → "dev").
# Load with:  posting --collection http/posting --env http/posting/dev.env
#
# With the default .env.local the gateway serves the "api" global prefix at
# http://localhost:3000/api (main.ts app.setGlobalPrefix(API_GATEWAY_PREFIX)).
ENV_BASE_URL=http://localhost:3000/api
