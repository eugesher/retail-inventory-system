@baseUrl = {{ENV_BASE_URL}}

###

# @name login
POST {{baseUrl}}/auth/staff/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "admin1234"
}

###
@accessToken = {{login.response.body.$.accessToken}}

###

# @name warehouseLogin
POST {{baseUrl}}/auth/staff/login
Content-Type: application/json

{
  "email": "warehouse@example.com",
  "password": "warehouse1234"
}

###
@warehouseAccessToken = {{warehouseLogin.response.body.$.accessToken}}

###

# @name queryEventsByAggregate
GET {{baseUrl}}/audit/events?aggregateType=order&aggregateId=1&pageSize=50
Authorization: Bearer {{accessToken}}

###
@tracedCorrelationId = {{queryEventsByAggregate.response.body.$.items[0].correlationId}}

###

# @name queryEventsByCorrelation
GET {{baseUrl}}/audit/events?correlationId={{tracedCorrelationId}}&pageSize=50
Authorization: Bearer {{accessToken}}

###

# @name queryEventsByTypeAndRange
GET {{baseUrl}}/audit/events?eventType=retail.order.placed&from=2026-01-01T00:00:00.000Z&to=2027-01-01T00:00:00.000Z
Authorization: Bearer {{accessToken}}

###

# @name queryEventsInvertedRange
GET {{baseUrl}}/audit/events?from=2030-01-01T00:00:00.000Z&to=2020-01-01T00:00:00.000Z
Authorization: Bearer {{accessToken}}

###

# @name queryEventsForbidden
GET {{baseUrl}}/audit/events?pageSize=5
Authorization: Bearer {{warehouseAccessToken}}

###

# @name queryEntriesByAction
GET {{baseUrl}}/audit/entries?action=StaffUserRolesAssigned&pageSize=20
Authorization: Bearer {{accessToken}}

###

# @name queryEntriesByActor
GET {{baseUrl}}/audit/entries?actorId=00000000-0000-4000-a000-000000000001&pageSize=10
Authorization: Bearer {{accessToken}}

###

# @name traceByCorrelation
GET {{baseUrl}}/audit/trace/{{tracedCorrelationId}}
Authorization: Bearer {{accessToken}}

###

# @name traceUnknownCorrelation
GET {{baseUrl}}/audit/trace/00000000-0000-4000-9999-ffffffffffff
Authorization: Bearer {{accessToken}}
