@baseUrl = {{ENV_BASE_URL}}

###

# @name loginStaff
POST {{baseUrl}}/auth/staff/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "admin1234"
}

###
@accessToken = {{loginStaff.response.body.$.accessToken}}

###

# @name loginCustomer
POST {{baseUrl}}/auth/customer/login
Content-Type: application/json

{
  "email": "customer@example.com",
  "password": "customer1234"
}

###
@customerToken = {{loginCustomer.response.body.$.accessToken}}

###

# @name createCart
POST {{baseUrl}}/cart
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "currency": "USD"
}

###
@cartId = {{createCart.response.body.$.id}}

###

# @name addLine
POST {{baseUrl}}/cart/{{cartId}}/lines
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "variantId": 1,
  "quantity": 1
}

###

# @name placeOrder
POST {{baseUrl}}/cart/{{cartId}}/place
Authorization: Bearer {{customerToken}}
Idempotency-Key: {{$guid}}
Content-Type: application/json

{
  "shippingAddress": {
    "recipientName": "Jane Buyer",
    "line1": "1 Market St",
    "city": "San Francisco",
    "region": "CA",
    "postalCode": "94105",
    "country": "US"
  },
  "billingAddress": {
    "recipientName": "Jane Buyer",
    "line1": "1 Market St",
    "city": "San Francisco",
    "region": "CA",
    "postalCode": "94105",
    "country": "US"
  },
  "paymentMethod": "tok_visa"
}

###
@orderId = {{placeOrder.response.body.$.id}}

###

# @name capturePayment
POST {{baseUrl}}/orders/{{orderId}}/payments/capture
Authorization: Bearer {{accessToken}}
Idempotency-Key: {{$guid}}
Content-Type: application/json

{}

###
@paymentId = {{capturePayment.response.body.$.payment.id}}

###

@refundKey = {{$guid}}

# @name issueRefund
POST {{baseUrl}}/orders/{{orderId}}/refunds
Authorization: Bearer {{accessToken}}
Idempotency-Key: {{refundKey}}
Content-Type: application/json

{
  "paymentId": {{paymentId}},
  "amountMinor": 1000,
  "reason": "Goodwill price adjustment"
}

###

# @name issueRefundReplay
POST {{baseUrl}}/orders/{{orderId}}/refunds
Authorization: Bearer {{accessToken}}
Idempotency-Key: {{refundKey}}
Content-Type: application/json

{
  "paymentId": {{paymentId}},
  "amountMinor": 1000,
  "reason": "Goodwill price adjustment"
}

###

# @name issueRefundDifferentBody
POST {{baseUrl}}/orders/{{orderId}}/refunds
Authorization: Bearer {{accessToken}}
Idempotency-Key: {{refundKey}}
Content-Type: application/json

{
  "paymentId": {{paymentId}},
  "amountMinor": 2000,
  "reason": "Goodwill price adjustment"
}

###

# @name listRefunds
GET {{baseUrl}}/orders/{{orderId}}/refunds
Authorization: Bearer {{accessToken}}

###

# @name createCartB
POST {{baseUrl}}/cart
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "currency": "USD"
}

###
@cartIdB = {{createCartB.response.body.$.id}}

###

# @name addLineB
POST {{baseUrl}}/cart/{{cartIdB}}/lines
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "variantId": 1,
  "quantity": 1
}

###

# @name placeOrderB
POST {{baseUrl}}/cart/{{cartIdB}}/place
Authorization: Bearer {{customerToken}}
Idempotency-Key: {{$guid}}
Content-Type: application/json

{
  "shippingAddress": {
    "recipientName": "Jane Buyer",
    "line1": "1 Market St",
    "city": "San Francisco",
    "region": "CA",
    "postalCode": "94105",
    "country": "US"
  },
  "billingAddress": {
    "recipientName": "Jane Buyer",
    "line1": "1 Market St",
    "city": "San Francisco",
    "region": "CA",
    "postalCode": "94105",
    "country": "US"
  },
  "paymentMethod": "tok_visa"
}

###
@orderIdB = {{placeOrderB.response.body.$.id}}

###

# @name capturePaymentB
POST {{baseUrl}}/orders/{{orderIdB}}/payments/capture
Authorization: Bearer {{accessToken}}
Idempotency-Key: {{$guid}}
Content-Type: application/json

{}

###

# @name cancelOrderB
POST {{baseUrl}}/orders/{{orderIdB}}/cancel
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "reason": "Customer cancelled after capture"
}

###

# @name listRefundsB
GET {{baseUrl}}/orders/{{orderIdB}}/refunds
Authorization: Bearer {{accessToken}}
