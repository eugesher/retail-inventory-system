@baseUrl = {{ENV_BASE_URL}}

###

# @name login
POST {{baseUrl}}/auth/customer/login
Content-Type: application/json

{
  "email": "customer@example.com",
  "password": "customer1234"
}

###
@accessToken = {{login.response.body.$.accessToken}}

###

# @name createCart
POST {{baseUrl}}/cart
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "currency": "USD"
}

###
@cartId = {{createCart.response.body.$.id}}

###

# @name addLineOne
POST {{baseUrl}}/cart/{{cartId}}/lines
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "variantId": 1,
  "quantity": 2
}

###

# @name addLineTwo
POST {{baseUrl}}/cart/{{cartId}}/lines
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "variantId": 3,
  "quantity": 1
}

###

@placeKey = {{$guid}}

# @name placeOrder
POST {{baseUrl}}/cart/{{cartId}}/place
Authorization: Bearer {{accessToken}}
Idempotency-Key: {{placeKey}}
Content-Type: application/json

{
  "shippingAddress": {
    "recipientName": "Jane Buyer",
    "line1": "1 Market St",
    "line2": "Suite 400",
    "city": "San Francisco",
    "region": "CA",
    "postalCode": "94105",
    "country": "US",
    "phone": "+1-415-555-0100"
  },
  "billingAddress": {
    "recipientName": "Jane Buyer",
    "line1": "1 Market St",
    "city": "San Francisco",
    "region": "CA",
    "postalCode": "94105",
    "country": "US"
  },
  "paymentMethod": "tok_visa"
}

###
@orderId = {{placeOrder.response.body.$.id}}

###

# @name placeOrderReplay
POST {{baseUrl}}/cart/{{cartId}}/place
Authorization: Bearer {{accessToken}}
Idempotency-Key: {{placeKey}}
Content-Type: application/json

{
  "shippingAddress": {
    "recipientName": "Jane Buyer",
    "line1": "1 Market St",
    "line2": "Suite 400",
    "city": "San Francisco",
    "region": "CA",
    "postalCode": "94105",
    "country": "US",
    "phone": "+1-415-555-0100"
  },
  "billingAddress": {
    "recipientName": "Jane Buyer",
    "line1": "1 Market St",
    "city": "San Francisco",
    "region": "CA",
    "postalCode": "94105",
    "country": "US"
  },
  "paymentMethod": "tok_visa"
}

###

# @name placeOrderDifferentBody
POST {{baseUrl}}/cart/{{cartId}}/place
Authorization: Bearer {{accessToken}}
Idempotency-Key: {{placeKey}}
Content-Type: application/json

{
  "shippingAddress": {
    "recipientName": "Someone Else",
    "line1": "500 Howard St",
    "city": "San Francisco",
    "region": "CA",
    "postalCode": "94105",
    "country": "US"
  },
  "billingAddress": {
    "recipientName": "Someone Else",
    "line1": "500 Howard St",
    "city": "San Francisco",
    "region": "CA",
    "postalCode": "94105",
    "country": "US"
  },
  "paymentMethod": "tok_visa"
}

###

# @name getOrder
GET {{baseUrl}}/orders/{{orderId}}
Authorization: Bearer {{accessToken}}

###

# @name listMyOrders
GET {{baseUrl}}/orders?page=1&pageSize=10
Authorization: Bearer {{accessToken}}

###

@captureKey = {{$guid}}

# @name capturePayment
POST {{baseUrl}}/orders/{{orderId}}/payments/capture
Authorization: Bearer {{accessToken}}
Idempotency-Key: {{captureKey}}
Content-Type: application/json

{}

###

# @name capturePaymentReplay
POST {{baseUrl}}/orders/{{orderId}}/payments/capture
Authorization: Bearer {{accessToken}}
Idempotency-Key: {{captureKey}}
Content-Type: application/json

{}

###

# @name placeOrderAgain
POST {{baseUrl}}/cart/{{cartId}}/place
Authorization: Bearer {{accessToken}}
Idempotency-Key: {{$guid}}
Content-Type: application/json

{
  "shippingAddress": {
    "recipientName": "Jane Buyer",
    "line1": "1 Market St",
    "city": "San Francisco",
    "region": "CA",
    "postalCode": "94105",
    "country": "US"
  },
  "billingAddress": {
    "recipientName": "Jane Buyer",
    "line1": "1 Market St",
    "city": "San Francisco",
    "region": "CA",
    "postalCode": "94105",
    "country": "US"
  }
}
